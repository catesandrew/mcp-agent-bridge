#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
. "${HOME}/.bin/launch-agent-runtime"

launch_agent_setup_node "claude-mcp-http"
launch_agent_require_command claude-mcp-server

claude_mcp_port="${CLAUDE_MCP_HTTP_PORT:-8940}"
claude_mcp_stream_endpoint="${CLAUDE_MCP_STREAM_ENDPOINT:-/mcp}"

exec npx -y mcp-proxy@6.4.4 \
  --host 127.0.0.1 \
  --port "${claude_mcp_port}" \
  --server stream \
  --streamEndpoint "${claude_mcp_stream_endpoint}" \
  -- \
  claude-mcp-server
