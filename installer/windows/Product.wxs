<?xml version="1.0" encoding="utf-8"?>
<!--
  mcp-agent-bridge — Windows MSI installer (WiX v5)
  Plan: .omc/plans/2026-07-16-windows-msi-installer.md

  BUILD REQUIREMENT: this file uses the WixToolset.Util.wixext extension
  (WixQuietExec, referenced via BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)")
  to run each service-registration script as a deferred custom action. Build
  with:
    wix build Product.wxs -ext WixToolset.Util.wixext -arch x64 ^
      -d Version=<x.y.z> ^
      -d ClaudeExe=bin\claude-mcp-server.exe ^
      -d CodexExe=bin\codex-mcp-server.exe ^
      -d CopilotExe=bin\copilot-mcp-server.exe ^
      -d McpProxyDir=vendor\mcp-proxy ^
      -d NssmExe=vendor\nssm\nssm.exe ^
      -out dist\mcp-agent-bridge-windows-x64.msi
  (see build.ps1 for the actual invocation — these -d values are illustrative)

  NOT BUILD-VERIFIED: `wix build` does not run on macOS at all (confirmed by
  direct testing — a genuine bug in its path-relativity check, not just the
  toolset's advisory "Windows only" warning). Every element below is authored
  against the WiX v5 schema and NSSM's documented behavior (see
  progress.txt's "RESEARCH" entry for citations), but has not been build- or
  install-tested. First real verification must happen on Windows or via the
  windows-latest GitHub Actions CI runner.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="mcp-agent-bridge"
    Manufacturer="mcp-agent-bridge"
    Version="$(var.Version)"
    UpgradeCode="7D1E8BEA-0BE6-4ECB-B464-85BAB1B7CABD"
    Scope="perMachine">
    <!-- UpgradeCode above must never change across releases once shipped.
         Version is threaded in via the -d Version=<x.y.z> preprocessor
         variable (matching package.json's version), not hardcoded — see
         build.ps1 for the actual `wix build -d Version=...` invocation. -->

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      Schedule="afterInstallExecute" />
    <!-- afterInstallExecute: installs the new version "on top of" the old one
         in one transaction, then removes components no longer present. Since
         each service's ServiceControl has Wait="yes", the old service is
         fully stopped before file replacement regardless of schedule choice
         (that's governed by RestartManager file-in-use detection, not
         MajorUpgrade's Schedule) — this avoids the "file in use"/reboot-
         prompt failure mode on upgrade. -->

    <MediaTemplate EmbedCab="yes" />

    <!-- ================= Ports: defaults matching the library's / pr-bot's
         own defaults, overridable via `msiexec /i ... CLAUDEPORT=9940` ================= -->
    <Property Id="CLAUDEPORT" Value="8940" Secure="yes" />
    <Property Id="CODEXPORT" Value="8941" Secure="yes" />
    <Property Id="COPILOTPORT" Value="8945" Secure="yes" />

    <!-- Numeric range validation — WiX/MSI's Launch condition grammar
         auto-coerces a Property's string value against integer literals for
         these comparison operators, no custom action needed (confirmed:
         Microsoft's Conditional Statement Syntax reference). -->
    <Launch Condition="CLAUDEPORT &gt;= 1024 AND CLAUDEPORT &lt;= 65535"
            Message="CLAUDEPORT must be a number between 1024 and 65535." />
    <Launch Condition="CODEXPORT &gt;= 1024 AND CODEXPORT &lt;= 65535"
            Message="CODEXPORT must be a number between 1024 and 65535." />
    <Launch Condition="COPILOTPORT &gt;= 1024 AND COPILOTPORT &lt;= 65535"
            Message="COPILOTPORT must be a number between 1024 and 65535." />
    <Launch Condition="CLAUDEPORT &lt;&gt; CODEXPORT"
            Message="CLAUDEPORT and CODEXPORT must not be the same port." />
    <Launch Condition="CLAUDEPORT &lt;&gt; COPILOTPORT"
            Message="CLAUDEPORT and COPILOTPORT must not be the same port." />
    <Launch Condition="CODEXPORT &lt;&gt; COPILOTPORT"
            Message="CODEXPORT and COPILOTPORT must not be the same port." />

    <!-- ================= Directory layout ================= -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="mcp-agent-bridge">
        <Directory Id="BINDIR" Name="bin" />
        <Directory Id="PROXYDIR" Name="proxy" />
        <Directory Id="SCRIPTSDIR" Name="scripts" />
        <Directory Id="VENDORDIR" Name="vendor">
          <Directory Id="NSSMDIR" Name="nssm" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- ================= Common: always-installed files (not user-
         deselectable) shared by all 3 services — vendored mcp-proxy, nssm.exe,
         the registration script, and the machine PATH entry. Hidden from any
         features UI so it can't be deselected independently of the product
         itself. ================= -->
    <Feature Id="Common" Title="Common files" Level="1" Display="hidden">
      <ComponentGroupRef Id="McpProxyFiles" />
      <ComponentRef Id="NssmExeComponent" />
      <ComponentRef Id="RegisterScriptComponent" />
      <ComponentRef Id="PathEnvComponent" />
    </Feature>

    <ComponentGroup Id="McpProxyFiles" Directory="PROXYDIR">
      <!-- Recursively harvests the entire vendored mcp-proxy tree (package
           files + node_modules, ~93 packages / 7.8MB — see
           installer/windows/vendor/mcp-proxy/SOURCE.md) without hand-authoring
           hundreds of individual <File> elements. Confirmed: WiX v5's Files
           element generates one Component per matched file, preserves the
           source subdirectory structure under PROXYDIR, and a bare trailing
           \** is the correct (and only needed) recursive glob. -->
      <Files Include="$(var.McpProxyDir)\**">
        <!-- node_modules/.bin/pipenet is an npm-created symlink (confirmed
             present in the vendored tree) purely for CLI convenience — not on
             mcp-proxy's require/import path, so not needed at runtime here.
             Excluded rather than risk relying on undocumented (and untested
             from this session) WiX symlink-harvesting behavior. -->
        <Exclude Files="$(var.McpProxyDir)\node_modules\.bin\**" />
      </Files>
    </ComponentGroup>

    <Component Id="NssmExeComponent" Directory="NSSMDIR" Guid="*">
      <File Id="NssmExeFile" Source="$(var.NssmExe)" KeyPath="yes" />
    </Component>

    <Component Id="RegisterScriptComponent" Directory="SCRIPTSDIR" Guid="*">
      <File Id="RegisterServiceScriptFile" Source="scripts\register-service.ps1" KeyPath="yes" />
    </Component>

    <Component Id="PathEnvComponent" Directory="BINDIR" Guid="*" KeyPath="yes">
      <Environment Id="AddInstallBinToSystemPath"
                   Name="PATH"
                   Value="[BINDIR]"
                   Part="last"
                   Action="set"
                   System="yes"
                   Permanent="no" />
    </Component>

    <!-- ================= Claude MCP Server ================= -->
    <Feature Id="ClaudeService" Title="Claude MCP Server" Level="1">
      <Component Id="ClaudeExeComponent" Directory="BINDIR" Guid="*">
        <File Id="ClaudeExeFile" Source="$(var.ClaudeExe)" KeyPath="yes" />

        <ServiceControl Id="ClaudeServiceControl"
                         Name="McpBridgeClaude"
                         Start="install"
                         Stop="both"
                         Remove="uninstall"
                         Wait="yes" />
        <!-- ServiceControl operates purely via SCM APIs by service name — it
             works to stop/remove McpBridgeClaude on uninstall/upgrade even
             though NSSM (not a WiX ServiceInstall element) is what originally
             registers it via InstallClaudeService below. Confirmed via the
             MSI ServiceControl table's own docs: "This column can be used to
             control a service that is not installed [by this package]." -->
      </Component>

      <!-- Immediate SetProperty + deferred CustomAction pair, using the
           official WixQuietExec pattern (WixToolset.Util.wixext): Windows
           Installer copies the property's resolved value into
           CustomActionData because it shares the same Id as the deferred
           CustomAction that follows. All [INSTALLFOLDER]/[CLAUDEPORT]-style
           tokens below are resolved to plain literal values at this
           (immediate) point, before being handed to the deferred action. -->
      <SetProperty Id="InstallClaudeService"
                   Value="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[SCRIPTSDIR]register-service.ps1&quot; -ServiceName McpBridgeClaude -NssmExe &quot;[NSSMDIR]nssm.exe&quot; -McpProxyEntry &quot;[PROXYDIR]dist\bin\mcp-proxy.mjs&quot; -TargetExe &quot;[BINDIR]claude-mcp-server.exe&quot; -Port [CLAUDEPORT] -PortEnvVar CLAUDE_MCP_HTTP_PORT -InstallRoot &quot;[INSTALLFOLDER]&quot;"
                   Before="InstallClaudeService"
                   Sequence="execute" />
      <CustomAction Id="InstallClaudeService"
                    BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                    DllEntry="WixQuietExec"
                    Execute="deferred"
                    Impersonate="no"
                    Return="check" />
    </Feature>

    <!-- ================= Codex MCP Server ================= -->
    <Feature Id="CodexService" Title="Codex MCP Server" Level="1">
      <Component Id="CodexExeComponent" Directory="BINDIR" Guid="*">
        <File Id="CodexExeFile" Source="$(var.CodexExe)" KeyPath="yes" />

        <ServiceControl Id="CodexServiceControl"
                         Name="McpBridgeCodex"
                         Start="install"
                         Stop="both"
                         Remove="uninstall"
                         Wait="yes" />
      </Component>

      <SetProperty Id="InstallCodexService"
                   Value="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[SCRIPTSDIR]register-service.ps1&quot; -ServiceName McpBridgeCodex -NssmExe &quot;[NSSMDIR]nssm.exe&quot; -McpProxyEntry &quot;[PROXYDIR]dist\bin\mcp-proxy.mjs&quot; -TargetExe &quot;[BINDIR]codex-mcp-server.exe&quot; -Port [CODEXPORT] -PortEnvVar CODEX_MCP_HTTP_PORT -InstallRoot &quot;[INSTALLFOLDER]&quot;"
                   Before="InstallCodexService"
                   Sequence="execute" />
      <CustomAction Id="InstallCodexService"
                    BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                    DllEntry="WixQuietExec"
                    Execute="deferred"
                    Impersonate="no"
                    Return="check" />
    </Feature>

    <!-- ================= Copilot MCP Server ================= -->
    <Feature Id="CopilotService" Title="Copilot MCP Server" Level="1">
      <Component Id="CopilotExeComponent" Directory="BINDIR" Guid="*">
        <File Id="CopilotExeFile" Source="$(var.CopilotExe)" KeyPath="yes" />

        <ServiceControl Id="CopilotServiceControl"
                         Name="McpBridgeCopilot"
                         Start="install"
                         Stop="both"
                         Remove="uninstall"
                         Wait="yes" />
      </Component>

      <SetProperty Id="InstallCopilotService"
                   Value="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[SCRIPTSDIR]register-service.ps1&quot; -ServiceName McpBridgeCopilot -NssmExe &quot;[NSSMDIR]nssm.exe&quot; -McpProxyEntry &quot;[PROXYDIR]dist\bin\mcp-proxy.mjs&quot; -TargetExe &quot;[BINDIR]copilot-mcp-server.exe&quot; -Port [COPILOTPORT] -PortEnvVar COPILOT_MCP_HTTP_PORT -InstallRoot &quot;[INSTALLFOLDER]&quot;"
                   Before="InstallCopilotService"
                   Sequence="execute" />
      <CustomAction Id="InstallCopilotService"
                    BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                    DllEntry="WixQuietExec"
                    Execute="deferred"
                    Impersonate="no"
                    Return="check" />
    </Feature>

    <!-- ================= Task 7: Non-blocking prerequisite check =================
         Warns (never blocks — Design Decision 5) if node.exe/npx, or a
         SELECTED feature's underlying agent CLI (claude/codex/copilot),
         isn't found on the MACHINE PATH. Runs check-prereqs.ps1 as an
         IMMEDIATE CustomAction in the UI sequence (not InstallExecuteSequence)
         because Task 7's acceptance criteria call for a future warning
         dialog, and deferred actions cannot interact with the UI at all. -->

    <!-- Feature-selection flags: resolve each service's requested-install
         state (native WiX "&FeatureId=3" == INSTALLSTATE_LOCAL condition
         operator, same operator already used above for the service
         registration actions) into a plain command-line switch BEFORE
         building check-prereqs.ps1's command line, so the script only checks
         the CLI for features the user actually selected. A property left
         unset by its conditioned SetProperty simply keeps its declared ""
         default (declarative "else" branch). -->
    <Property Id="PREREQ_CLAUDE_FLAG" Value="" />
    <Property Id="PREREQ_CODEX_FLAG" Value="" />
    <Property Id="PREREQ_COPILOT_FLAG" Value="" />

    <SetProperty Id="PREREQ_CLAUDE_FLAG" Value="-CheckClaude"
                 Before="WixQuietExecCmdLine" After="CostFinalize" Sequence="ui"
                 Condition="&amp;ClaudeService=3" />
    <SetProperty Id="PREREQ_CODEX_FLAG" Value="-CheckCodex"
                 Before="WixQuietExecCmdLine" After="CostFinalize" Sequence="ui"
                 Condition="&amp;CodexService=3" />
    <SetProperty Id="PREREQ_COPILOT_FLAG" Value="-CheckCopilot"
                 Before="WixQuietExecCmdLine" After="CostFinalize" Sequence="ui"
                 Condition="&amp;CopilotService=3" />

    <!-- WixQuietExec's IMMEDIATE-execution form reads its command line from
         the well-known "WixQuietExecCmdLine" property — a fixed reserved
         name distinct from the same-Id-as-the-CA SetProperty trick used
         above for the three DEFERRED service-registration actions. That
         trick exists only to bridge a property into a deferred action's
         restricted CustomActionData view; it does not apply here since
         CheckPrereqs is immediate and can read ordinary properties. Confirmed
         via WiX/FireGiant docs for WixQuietExec: "define a Property with Id
         WixQuietExecCmdLine set to your command line, then reference
         WixQuietExec as the DllEntry in a CustomAction with
         Execute=immediate." WixQuietExec also logs the command line and all
         console output from the invoked process automatically — this is what
         satisfies "always writes results to the MSI log regardless of UI
         level" (log emission is independent of whether any dialog is ever
         shown). -->
    <SetProperty Id="WixQuietExecCmdLine"
                 Value="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[SCRIPTSDIR]check-prereqs.ps1&quot; [PREREQ_CLAUDE_FLAG] [PREREQ_CODEX_FLAG] [PREREQ_COPILOT_FLAG]"
                 Before="CheckPrereqs" Sequence="ui" />
    <CustomAction Id="CheckPrereqs"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="immediate"
                  Return="ignore" />
    <!-- Return="ignore" is redundant with check-prereqs.ps1's own guaranteed
         exit 0 (Design Decision 5: never block), but is defense in depth at
         the WiX layer too — a non-zero exit here still could never fail the
         install even if the script's own guarantee were somehow violated. -->

    <!-- ================= Sequencing =================
         Each service's install action must run after its own exe (and the
         shared nssm.exe/mcp-proxy/script files) are actually on disk, and
         ServiceControl's Start="install" (native, sequenced automatically by
         WiX in StartServices) must fire after that. InstallFiles is the
         standard action that copies all File-based components; scheduling
         each InstallXService custom action After="InstallFiles" covers all
         three since they all depend on the same InstallFiles pass having
         completed, regardless of which subset of features was selected. -->
    <InstallExecuteSequence>
      <Custom Action="InstallClaudeService" After="InstallFiles" Condition="&amp;ClaudeService=3" />
      <Custom Action="InstallCodexService" After="InstallFiles" Condition="&amp;CodexService=3" />
      <Custom Action="InstallCopilotService" After="InstallFiles" Condition="&amp;CopilotService=3" />
    </InstallExecuteSequence>
    <!-- Condition "&amp;FeatureId=3" (INSTALLSTATE_LOCAL) ensures each
         service's nssm-install script only runs when that specific feature
         was actually selected for install — the earlier, corresponding
         ServiceControl Start="install" is itself already scoped to its own
         Feature's Component, so it won't try to start a service that was
         never selected/registered. -->

    <!-- CRITICAL (prd.json US-07): CheckPrereqs must be skipped ENTIRELY
         when UILevel <= 3 (silent "/quiet" == 2, basic "/passive" == 3) —
         the Condition below is authored as explicit defense-in-depth per the
         acceptance criteria's literal wording, rather than relying solely on
         msiexec's own tendency not to process InstallUISequence at all under
         those UI levels. -->
    <InstallUISequence>
      <Custom Action="CheckPrereqs" After="CostFinalize" Condition="UILevel &gt; 3" />
    </InstallUISequence>
    <!-- KNOWN GAP / FAST-FOLLOW, documented honestly rather than left
         silent: the interactive WARNING DIALOG described in Design
         Decision 5 ("a non-blocking dialog... listing any missing
         prerequisites") is NOT authored in this pass. WiX v5 moved
         Dialog/Control authoring into a SEPARATE extension
         (WixToolset.UI.wixext, xmlns .../v4/wxs/ui) that this installer does
         not otherwise reference, and a real custom Dialog needs a full Text
         control bound to a property plus a PushButton wired to EndDialog —
         none of which can be build- or render-tested from this (macOS, `wix
         build` confirmed broken) session. An Error-type CustomAction
         (`<CustomAction Error="...">`) was considered and rejected: it is a
         type-19 MSI action that calls MsiProcessMessage(INSTALLMESSAGE_ERROR)
         and unconditionally aborts/rolls back the install — inherently
         blocking, which directly violates Design Decision 5 ("warn, don't
         block"). Rather than author untested custom-dialog XML that pulls in
         a new extension, this pass ships the always-non-blocking,
         always-logged check above (log-only path) and defers the actual
         pop-up dialog to a fast-follow, to be authored and verified on a real
         Windows machine alongside the rest of this plan's Windows-only
         verification steps (see Verification Steps in
         .omc/plans/2026-07-16-windows-msi-installer.md). -->
  </Package>
</Wix>
