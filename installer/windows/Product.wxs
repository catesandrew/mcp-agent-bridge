<?xml version="1.0" encoding="utf-8"?>
<!--
  mcp-agent-bridge — Windows MSI installer (WiX v5)

  This is a MINIMAL placeholder skeleton (Task 1 of
  .omc/plans/2026-07-16-windows-msi-installer.md). It exists only to
  establish a structurally plausible starting point for the WiX build loop.

  A follow-up task will fill this in with the real content:
    - 3 independent <Feature> elements (Claude, Codex, Copilot), each with
      a <Component> harvesting its renamed .exe and a deferred
      <CustomAction> that registers an NSSM-wrapped Windows Service,
      plus <ServiceControl> for start/stop/remove.
    - <MajorUpgrade Schedule="afterInstallExecute" .../> for safe upgrades.
    - <Environment> element to append the install bin\ directory to the
      machine PATH.
    - <Property> elements for CLAUDEPORT/CODEXPORT/COPILOTPORT with launch
      condition validation.

  Do NOT add speculative Feature/Service/MajorUpgrade/Environment/Property
  elements here — this file is intentionally a bare skeleton; the real
  content is being authored directly by a follow-up task on this same file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="mcp-agent-bridge"
    Manufacturer="mcp-agent-bridge"
    Version="1.0.0"
    UpgradeCode="7D1E8BEA-0BE6-4ECB-B464-85BAB1B7CABD">
    <!-- TODO: this UpgradeCode must never change across releases once shipped -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="mcp-agent-bridge" />
    </StandardDirectory>
  </Package>
</Wix>
