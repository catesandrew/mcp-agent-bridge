{
  "name": "mcp-agent-bridge",
  "version": "0.1.0",
  "description": "Bridges AI coding agents (Claude Code, OpenAI Codex, GitHub Copilot) as MCP servers behind HTTP proxies",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/claude/claude-runner.d.ts",
      "import": "./dist/claude/claude-runner.js"
    },
    "./dist/claude/claude-runner.js": {
      "types": "./dist/claude/claude-runner.d.ts",
      "import": "./dist/claude/claude-runner.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "claude-mcp-server": "./bin/claude-mcp-server",
    "codex-mcp-server": "./bin/codex-mcp-server",
    "copilot-mcp-server": "./bin/copilot-mcp-server"
  },
  "scripts": {
    "build": "tsc",
    "build:exe": "bun build --compile --outfile exe/claude-mcp-server src/claude/server.ts && bun build --compile --outfile exe/codex-mcp-server src/codex/server.ts && bun build --compile --outfile exe/copilot-mcp-server src/copilot/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist exe"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
